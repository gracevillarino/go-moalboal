---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = (value: string) => `${base}${value}`;

const nav = [
  ['Explore', '/explore'],
  ['Directory', '/directory'],
  ['Living here', '/living'],
  ['Community', '/community'],
  ['Stories', '/stories'],
];
---

<header class="site-header">
  <a class="brand" href={path('/')} aria-label="Go Moalboal home">
    <img
      src={path('/brand/go-moalboal-logo.png?v=3804c887')}
      alt="Go Moalboal"
      width="1672"
      height="941"
    />
  </a>
  <nav aria-label="Primary navigation">
    {nav.map(([label, href]) => <a href={path(href)}>{label}</a>)}
  </nav>
  <a class="help-link" href={path('/community#help')}>How can I help?</a>
</header>
