---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import YouTubeCarousel from '../../components/YouTubeCarousel.astro';
import { instagramProfiles } from '../../data/explore-media';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const guides = (await getCollection('guides', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const categoryLabels: Record<string, string> = {
  food: 'Food', diving: 'Diving', beaches: 'Beaches', 'day-trips': 'Day trips',
  'first-visit': 'First visit', snorkelling: 'Snorkelling', biodiversity: 'Biodiversity',
  recreation: 'Recreation',
};
---

<BaseLayout
  title="Explore Moalboal — Videos, local guides and creators"
  description="Plan a Moalboal visit with useful videos, active local Instagram profiles and practical guides to food, diving, beaches and day trips."
>
  <section class="explore-hero section">
    <p class="eyebrow">Explore</p>
    <h1>See the town<br />with local context.</h1>
    <p class="hero-intro">Start with the water, stay for the food and make room for the places between the headline attractions.</p>
    <div class="hero-links">
      <a class="button" href="#guides">Read the guides</a>
      <a class="button secondary" href="#watch">Watch Moalboal</a>
      <a class="button secondary" href={`${base}/explore/dive-map`}>Dive map ↗</a>
    </div>
  </section>

  <div id="watch"><YouTubeCarousel /></div>

  <section class="instagram-section section" aria-labelledby="instagram-heading">
    <div class="section-heading">
      <div><p class="eyebrow">Follow the action</p><h2 id="instagram-heading">Three useful<br />Instagram follows.</h2></div>
      <p>Active specialist profiles for seeing what is happening on, beside and beneath the water. Instagram activity can change, so follow through for the latest posts.</p>
    </div>
    <div class="instagram-grid">
      {instagramProfiles.map((profile) => (
        <a class={`instagram-profile ${profile.accent}`} href={profile.url} target="_blank" rel="noreferrer">
          <span class="instagram-mark" aria-hidden="true">◎</span>
          <p>@{profile.handle}</p>
          <h3>{profile.name}</h3>
          <span>{profile.focus}</span>
          <strong>Open Instagram ↗</strong>
        </a>
      ))}
    </div>
  </section>

  <section class="guides-section section" id="guides" aria-labelledby="guides-heading">
    <div class="section-heading">
      <div><p class="eyebrow">Plan with context</p><h2 id="guides-heading">Seven guides for<br />a better visit.</h2></div>
      <p>Research-backed editorial drafts prepared for local review. Practical detail first, exaggerated bucket lists last.</p>
    </div>
    <div class="guide-grid">
      {guides.map((guide, index) => (
        <a class="guide-card" href={`${base}/explore/${guide.id}/`}>
          <div class="guide-number">0{index + 1}</div>
          <span class="pill">{categoryLabels[guide.data.category]}</span>
          <h3>{guide.data.title}</h3>
          <p>{guide.data.summary}</p>
          <footer><span>{guide.data.readingMinutes} min read</span><strong>Read guide →</strong></footer>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .explore-hero { min-height: 680px; display: flex; flex-direction: column; justify-content: center; background: linear-gradient(120deg, rgba(248,242,229,.98) 50%, rgba(8,127,120,.16)); }
  .hero-intro { max-width: 41rem; margin: 2rem 0 0; color: #47635d; font-size: clamp(1.05rem, 2vw, 1.35rem); }
  .hero-links { display: flex; gap: .7rem; margin-top: 2rem; }
  .instagram-section { background: var(--cream); }
  .instagram-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .instagram-profile { min-height: 320px; padding: 1.7rem; display: flex; flex-direction: column; border-radius: 24px; color: #fff; text-decoration: none; transition: transform .2s ease; }
  .instagram-profile:hover { transform: translateY(-4px); }
  .instagram-profile.coral { background: var(--coral); }
  .instagram-profile.sea { background: var(--sea); }
  .instagram-profile.sun { background: var(--sun); color: var(--ink); }
  .instagram-mark { font-size: 2.4rem; line-height: 1; }
  .instagram-profile p { margin: auto 0 .3rem; font-size: .8rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  .instagram-profile h3 { font-size: 2rem; }
  .instagram-profile > span:not(.instagram-mark) { max-width: 27rem; opacity: .9; }
  .instagram-profile strong { margin-top: 1.3rem; font-size: .88rem; }
  .guides-section { background: var(--paper); }
  .guide-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .guide-card { position: relative; min-height: 330px; padding: 1.6rem; display: flex; flex-direction: column; overflow: hidden; border: 1px solid var(--line); border-radius: 22px; color: inherit; text-decoration: none; }
  .guide-card:hover { border-color: var(--sea); transform: translateY(-3px); }
  .guide-card .pill { align-self: flex-start; }
  .guide-card h3 { max-width: 13ch; font-size: 2rem; }
  .guide-card > p { max-width: 32rem; color: #526b65; }
  .guide-number { position: absolute; right: 1rem; top: -.75rem; color: rgba(12,87,77,.08); font-family: 'Fraunces', serif; font-size: 7rem; line-height: 1; }
  .guide-card footer { display: flex; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: 1.5rem; font-size: .82rem; }
  .guide-card footer span { color: #60766f; }
  @media (max-width: 900px) { .instagram-grid, .guide-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 650px) { .instagram-grid, .guide-grid { grid-template-columns: 1fr; } .hero-links { align-items: flex-start; flex-direction: column; } }
</style>
