---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Go Moalboal"
  description="Suggest a Moalboal listing, report a closure or correction, or send a message to the Go Moalboal team."
>
  <div class="contact-page">
    <section class="contact-hero">
      <div>
        <p class="eyebrow">Contact us</p>
        <h1>Help keep the town<br />guide useful.</h1>
      </div>
      <p>Suggest a place, flag something that has changed, or send us a note. Community corrections help everyone find better information.</p>
    </section>

    <section class="contact-section">
      <form
        id="contact-form"
        action="https://formsubmit.co/hello@gomoalboal.com"
        method="POST"
      >
        <input type="hidden" name="_subject" value="New message from Go Moalboal" />
        <input type="hidden" name="_template" value="table" />
        <div class="honey" aria-hidden="true">
          <label for="website">Leave this field empty</label>
          <input id="website" name="_honey" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="field-row">
          <label>
            <span>Name</span>
            <input name="name" type="text" autocomplete="name" maxlength="100" required />
          </label>
          <label>
            <span>Email</span>
            <input name="email" type="email" autocomplete="email" maxlength="254" required />
          </label>
        </div>

        <label>
          <span>What’s this about?</span>
          <select name="topic" required>
            <option value="" selected disabled>Select one</option>
            <option value="Suggest or add a listing">Suggest or add a listing</option>
            <option value="Report a closure or correction">Report a closure or correction</option>
            <option value="Something else">Something else</option>
          </select>
        </label>

        <label>
          <span>Message</span>
          <textarea name="message" rows="8" maxlength="4000" required></textarea>
        </label>

        <div class="form-footer">
          <button type="submit">Send message</button>
          <p id="form-status" role="status" aria-live="polite">Messages are sent to hello@gomoalboal.com.</p>
        </div>
      </form>

      <aside>
        <p class="eyebrow">A quick note</p>
        <h2>Local knowledge changes.</h2>
        <p>Please include the place name and a link when reporting a listing. We review submissions before changing community-maintained information.</p>
        <a href="mailto:hello@gomoalboal.com">hello@gomoalboal.com</a>
      </aside>
    </section>
  </div>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLElement>('#form-status');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());

    status.textContent = 'Sending your message…';
    button?.setAttribute('disabled', '');

    try {
      const response = await fetch('https://formsubmit.co/ajax/hello@gomoalboal.com', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      });

      if (!response.ok) throw new Error('Contact service unavailable');

      form.reset();
      status.textContent = 'Thanks — your message has been sent.';
      status.dataset.state = 'success';
    } catch {
      status.innerHTML = 'We could not send that just now. Please email <a href="mailto:hello@gomoalboal.com">hello@gomoalboal.com</a>.';
      status.dataset.state = 'error';
    } finally {
      button?.removeAttribute('disabled');
    }
  });
</script>

<style>
  .contact-hero { display: grid; grid-template-columns: 1.35fr .65fr; gap: clamp(2rem, 8vw, 8rem); align-items: end; padding: clamp(5rem, 9vw, 9rem) 5vw; background: var(--cream); }
  .contact-hero h1 { max-width: 13ch; font-size: clamp(3.2rem, 7vw, 6.6rem); }
  .contact-hero > p { max-width: 32rem; color: #47635d; font-size: 1.15rem; }
  .contact-section { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(260px, .6fr); gap: clamp(3rem, 8vw, 8rem); padding: clamp(4rem, 8vw, 7rem) 5vw; }
  form { display: grid; gap: 1.4rem; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  label { display: grid; gap: .5rem; font-weight: 800; }
  label > span { font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; }
  input, select, textarea { width: 100%; padding: .95rem 1rem; border: 1px solid var(--line); border-radius: 12px; background: #fff; color: var(--ink); font: inherit; }
  input:focus, select:focus, textarea:focus { outline: 3px solid rgba(8, 127, 120, .18); border-color: var(--sea); }
  textarea { resize: vertical; }
  .honey { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .form-footer { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; }
  button { padding: .9rem 1.35rem; border: 0; border-radius: 999px; background: var(--coral); color: #fff; font: inherit; font-weight: 800; cursor: pointer; }
  button:disabled { cursor: wait; opacity: .65; }
  #form-status { margin: 0; color: #5a716b; font-size: .88rem; }
  #form-status[data-state='success'] { color: var(--sea); font-weight: 700; }
  #form-status[data-state='error'] { color: #9a3e30; }
  aside { align-self: start; padding: 2rem; border-radius: 22px; background: var(--sea); color: #fff; }
  aside h2 { margin: 1rem 0; font-size: clamp(2rem, 4vw, 3.2rem); }
  aside a { display: inline-block; margin-top: 1rem; color: #fff; font-weight: 800; }
  @media (max-width: 760px) {
    .contact-hero, .contact-section, .field-row { grid-template-columns: 1fr; }
    .contact-hero { align-items: start; }
  }
</style>
