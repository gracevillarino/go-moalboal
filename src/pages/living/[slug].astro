---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths() {
  const articles = await getCollection('living', ({ data }) => data.status === 'published');
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}
const { article } = Astro.props;
const { Content } = await render(article);
const { data } = article;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title={`${data.title} — Go Moalboal`} description={data.summary}>
  <article>
    <header class="article-hero"><a href={`${base}/living/`}>← Living here</a><p class="eyebrow">Practical guide</p><h1>{data.title}</h1><p class="dek">{data.summary}</p><div class="meta"><span>{data.readingMinutes} min read</span><span>{data.reviewStatus === 'locally-reviewed' ? 'Locally reviewed' : 'Local review draft'}</span><span>Checked {data.updatedAt.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })}</span></div></header>
    <div class="article-body"><Content /></div>
    <aside class="sources"><p class="eyebrow">Sources checked</p><ul>{data.sources.map((source) => <li><a href={source.url} target="_blank" rel="noreferrer">{source.title}</a><span>{source.publisher}</span></li>)}</ul><p>Information here is general and may change. Confirm contracts, immigration, medical and financial decisions with the relevant professional or government office.</p></aside>
  </article>
</BaseLayout>
<style>
  .article-hero { padding: clamp(4rem,8vw,8rem) max(5vw,calc((100% - 1100px)/2)); background: var(--cream); }
  .article-hero > a { display: inline-block; margin-bottom: 4rem; text-decoration: none; font-weight: 700; }
  .article-hero h1 { max-width: 13ch; font-size: clamp(3rem,7vw,6.2rem); }
  .dek { max-width: 48rem; margin: 2rem 0; color: #47635d; font-size: 1.2rem; }
  .meta { display: flex; flex-wrap: wrap; gap: .55rem; }.meta span { padding: .35rem .7rem; border: 1px solid var(--line); border-radius: 999px; font-size: .76rem; font-weight: 700; }
  .article-body { max-width: 760px; margin: auto; padding: clamp(4rem,8vw,7rem) 5vw; font-size: 1.08rem; }
  .article-body :global(h2) { margin: 3rem 0 1rem; font-size: clamp(2rem,4vw,3.1rem); }.article-body :global(h3) { margin-top: 2rem; }.article-body :global(p),.article-body :global(li) { color: #38534d; }.article-body :global(blockquote) { margin: 2rem 0; padding: 1.2rem 1.4rem; border-left: 4px solid var(--coral); background: var(--cream); }
  .sources { padding: 4rem max(5vw,calc((100% - 1100px)/2)); background: var(--sea); color: #eff5f1; }.sources ul { display: grid; grid-template-columns: repeat(2,1fr); gap: .7rem; padding: 0; list-style: none; }.sources li { padding: 1rem; border: 1px solid rgba(255,255,255,.17); border-radius: 14px; }.sources a { display: block; color: #fff; font-weight: 700; }.sources span,.sources > p:last-child { color: #d3e5df; font-size: .8rem; }
  @media(max-width:650px){.sources ul{grid-template-columns:1fr}}
</style>
