---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = (value: string) => `${base}${value}`;

const allBusinesses = await getCollection('businesses', ({ data }) => data.status === 'published');
const businesses = allBusinesses
  .sort((a, b) => (b.data.ratingCount - a.data.ratingCount) || a.data.name.localeCompare(b.data.name))
  .slice(0, 3);
const stories = (await getCollection('stories', ({ data }) => data.status === 'published'))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
  .slice(0, 3);

const governmentUpdates = [
  {
    title: 'Rosaroso, Gocotano nab Five golds in monthly dancesports tilt',
    date: 'July 1, 2026',
    url: 'https://moalboalcebu.gov.ph/rosaroso-gocotano-nab-five-golds-in-monthly-dancesports-tilt/',
    photo: 'https://moalboalcebu.gov.ph/wp-content/uploads/2026/07/dancesports-team.jpg',
    summary: 'Two Moalboal dancesport athletes swept five gold medals at a regional tilt in Naga City on June 27.',
  },
  {
    title: 'Moalboal LGU shows commitment to drug-free workplace with surprise drug test',
    date: 'June 30, 2026',
    url: 'https://moalboalcebu.gov.ph/moalboal-lgu-shows-commitment-to-drug-free-workplace-with-surprise-drug-test-for-employees-and-officials/',
    photo: 'https://moalboalcebu.gov.ph/wp-content/uploads/2026/06/Screenshot-2026-06-30-092639.png',
    summary: 'The LGU ran an unannounced drug test for municipal staff and officials to mark Anti-Drug Abuse Day.',
  },
  {
    title: 'Moalboal opens Agri-Fishery Trade Fair 2026',
    date: 'May 8, 2026',
    url: 'https://moalboalcebu.gov.ph/moalboal-opens-agri-fishery-trade-fair-2026/',
    photo: 'https://moalboalcebu.gov.ph/wp-content/uploads/2026/05/11.jpg',
    summary: 'The trade fair launched as a centerpiece of the 2026 Moalboal Town Fiesta celebration.',
  },
  {
    title: 'Moalboal Grand Caravan – May 12, 2026',
    date: 'May 8, 2026',
    url: 'https://moalboalcebu.gov.ph/moalboal-grand-caravan-may-12-2026/',
    photo: 'https://moalboalcebu.gov.ph/wp-content/uploads/2026/05/CARAVAN.jpg',
    summary: 'A day of free public services and assistance for residents, held at the town plaza.',
  },
  {
    title: 'Mental health consultation',
    date: 'May 8, 2026',
    url: 'https://moalboalcebu.gov.ph/mental-health-consultation/',
    photo: 'https://moalboalcebu.gov.ph/wp-content/uploads/2026/05/MENTAL-HEALTH.jpg',
    summary: 'Free monthly mental health consultations continue at the Senior Citizen Care Center behind the fire station.',
  },
  {
    title: 'Meet the Kagasangan Festival queen candidates',
    date: 'May 8, 2026',
    url: 'https://moalboalcebu.gov.ph/meet-the-kagasangan-festival-queen-candidates/',
    photo: 'https://moalboalcebu.gov.ph/wp-content/uploads/2026/05/KAGASANGAN.jpg',
    summary: 'This year’s Kagasangan Festival queen candidates were introduced ahead of the town fiesta.',
  },
];
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">The digital town square</p>
      <h1>Know the town.<br /><em>Find your people.</em></h1>
      <p class="intro">A community-made home for discovering Moalboal, finding trusted local services and helping good projects grow.</p>
      <div class="actions">
        <a class="button" href={path('/explore')}>Explore Moalboal</a>
        <a class="button secondary" href={path('/community#help')}>How can I help?</a>
      </div>
    </div>
    <div class="town-note" aria-label="Welcome note">
      <span class="sun"></span>
      <p class="eyebrow">Today in Moalboal</p>
      <h2>Start local.</h2>
      <p>Find a neighbourhood business, learn something from a resident, or lend a hand to a community project.</p>
      <span class="wave">maayong pag-abot</span>
    </div>
  </section>

  <section class="ticker" aria-label="Site highlights">
    <span>Local knowledge</span><i>✦</i><span>Community projects</span><i>✦</i><span>Useful town guides</span><i>✦</i><span>Trusted listings</span>
  </section>

  <section class="section explore-section">
    <div class="section-heading">
      <div><p class="eyebrow">Find your way</p><h2>Explore Moalboal</h2></div>
      <p>Look beyond the checklist. Discover places through local context, from an early coffee to an afternoon underwater.</p>
    </div>
    <div class="explore-grid">
      <a href={path('/directory?category=eat')} class="feature-card coral"><span>01</span><h3>Eat & drink</h3><p>Local tables, good coffee and where to go next.</p></a>
      <a href={path('/directory?category=stay')} class="feature-card sea"><span>02</span><h3>Stay awhile</h3><p>Find a base that fits the way you travel.</p></a>
      <a href={path('/directory?category=dive')} class="feature-card sun-card"><span>03</span><h3>Meet the sea</h3><p>Diving, snorkelling and responsible ocean experiences.</p></a>
    </div>
  </section>

  <section class="section help-section" id="help">
    <div>
      <p class="eyebrow">A town is something we make together</p>
      <h2>How can I help?</h2>
    </div>
    <div class="help-list">
      <a href={path('/community#volunteer')}><span>Volunteer locally</span><b>→</b></a>
      <a href={path('/community#organizations')}><span>Support an organization</span><b>→</b></a>
      <a href={path('/community#skills')}><span>Share a useful skill</span><b>→</b></a>
    </div>
  </section>

  <section class="section living-section">
    <div class="living-copy"><p class="eyebrow">For more than a holiday</p><h2>Living here,<br />made clearer.</h2><p>Practical, locally reviewed guides for the questions that maps cannot answer.</p><a href={path('/living')}>Browse living guides →</a></div>
    <div class="living-topics">
      <span>01</span><p>Moving to Moalboal</p><span>02</span><p>Internet & mobile</p><span>03</span><p>Finding a home</p><span>04</span><p>Healthcare</p>
    </div>
  </section>

  <section class="section">
    <div class="section-heading"><div><p class="eyebrow">{allBusinesses.length} approved places</p><h2>Meet the neighbourhood</h2></div><a href={path('/directory')}>Search the full directory →</a></div>
    <div class="grid">
      {businesses.map(({ data }) => (
        <a class="card" href={path(`/directory/${data.slug}`)}>
          {data.photos[0] && (
            <span class="card-photo">
              <img src={path(data.photos[0].path)} alt={data.name} loading="lazy" width={data.photos[0].width} height={data.photos[0].height} />
              <em>Photo: {data.photos[0].attribution.displayName} · Google Maps</em>
            </span>
          )}
          <span class="pill">{data.categories.join(' · ')}</span><h3>{data.name}</h3><p>{data.summary}</p>
          {data.rating && <b class="home-rating">★ {data.rating.toFixed(1)} · {data.ratingCount.toLocaleString()} reviews</b>}
        </a>
      ))}
    </div>
  </section>

  <section class="section home-stories">
    <div class="section-heading">
      <div><p class="eyebrow">From the source desk</p><h2>Stories of Moalboal</h2></div>
      <a href={path('/stories')}>Read all six stories →</a>
    </div>
    <div class="grid">
      {stories.map(({ data }) => (
        <a class="card story-preview" href={path(`/stories/${data.slug}`)}>
          {data.photos[0] && <span class="card-photo">
            <img src={path(data.photos[0].path)} alt={data.title} loading="lazy" width={data.photos[0].width} height={data.photos[0].height} />
            <em>Photo: {data.photos[0].attribution.displayName} · Wikimedia Commons</em>
          </span>}
          <span class="pill">{data.type.replace('-', ' ')}</span>
          <h3>{data.title}</h3>
          <p>{data.summary}</p>
          <b>{data.readingMinutes} min read · {data.sources.length} sources</b>
        </a>
      ))}
    </div>
  </section>

  <section class="section government-updates">
    <div class="section-heading">
      <div><p class="eyebrow">From the LGU</p><h2>Government Updates</h2></div>
      <a href="https://moalboalcebu.gov.ph/category/updates/" target="_blank" rel="noreferrer">View all on moalboalcebu.gov.ph →</a>
    </div>
    <div class="grid">
      {governmentUpdates.map((update) => (
        <a class="card update-card" href={update.url} target="_blank" rel="noreferrer">
          <span class="card-photo">
            <img src={update.photo} alt={update.title} loading="lazy" />
            <em>Source: moalboalcebu.gov.ph</em>
          </span>
          <span class="pill">{update.date}</span><h3>{update.title}</h3><p>{update.summary}</p>
          <b>Read on moalboalcebu.gov.ph ↗</b>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero { min-height: 690px; display: grid; grid-template-columns: 1.55fr .8fr; background: var(--cream); }
  .hero-copy { padding: clamp(5rem, 9vw, 9rem) 5vw; position: relative; }
  .hero-copy::after { content: ''; position: absolute; right: 4%; top: 16%; width: 9rem; height: 9rem; border: 1px solid var(--coral); border-radius: 48% 52% 55% 45%; transform: rotate(18deg); opacity: .45; }
  h1 em { color: var(--sea); font-weight: inherit; }
  .intro { font-size: 1.18rem; max-width: 39rem; margin: 2rem 0; }
  .actions { display: flex; gap: .8rem; flex-wrap: wrap; }
  .town-note { background: var(--sea); color: #fff; padding: 5rem 3rem 3rem; display: flex; flex-direction: column; justify-content: end; position: relative; }
  .town-note h2 { font-size: clamp(3rem, 6vw, 5rem); }
  .town-note p { max-width: 27rem; }
  .sun { position: absolute; top: 12%; right: 12%; width: clamp(6rem, 13vw, 12rem); aspect-ratio: 1; border-radius: 50%; background: var(--sun); }
  .wave { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,.35); font-family: 'Fraunces', serif; font-style: italic; }
  .ticker { display: flex; gap: 2.2rem; justify-content: center; align-items: center; padding: .85rem; white-space: nowrap; overflow: hidden; background: var(--coral); color: #fff; text-transform: uppercase; letter-spacing: .1em; font-weight: 800; font-size: .72rem; }
  .ticker i { color: var(--sun); }
  .explore-section { background: var(--paper); }
  .explore-grid { display: grid; grid-template-columns: 1.2fr .9fr .9fr; gap: 1rem; }
  .feature-card { min-height: 360px; padding: 2rem; display: flex; flex-direction: column; justify-content: end; border-radius: 24px; text-decoration: none; color: #fff; }
  .feature-card span { margin-bottom: auto; font-weight: 700; }
  .feature-card h3 { font-size: 2.2rem; }
  .feature-card p { max-width: 22rem; }
  .coral { background: var(--coral); } .sea { background: var(--forest); } .sun-card { background: var(--sun); color: var(--ink); }
  .help-section { background: var(--ink); color: #fff; display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }
  .help-list a { display: flex; justify-content: space-between; padding: 1.35rem 0; border-bottom: 1px solid rgba(255,255,255,.25); text-decoration: none; font-size: 1.2rem; }
  .help-list b { color: var(--sun); }
  .living-section { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; background: var(--cream); }
  .living-copy p { max-width: 32rem; } .living-copy a { font-weight: 700; }
  .living-topics { display: grid; grid-template-columns: auto 1fr; align-content: center; }
  .living-topics span, .living-topics p { padding: 1rem; margin: 0; border-bottom: 1px solid var(--line); }
  .living-topics span { color: var(--coral); font-weight: 700; }
  .card-photo { display: block; margin: -1px -1px 1rem; position: relative; }
  .card-photo img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 14px; }
  .card-photo em { position: absolute; right: .6rem; bottom: .6rem; padding: .2rem .5rem; border-radius: 6px; background: rgba(0,0,0,.55); color: #fff; font-size: .62rem; font-style: normal; }
  .home-rating, .story-preview b { display: block; margin-top: 1rem; color: var(--sea); font-size: .82rem; }
  .home-stories { background: var(--cream); }
  .story-preview { background: var(--paper); }
  .government-updates { background: var(--paper); }
  .update-card { background: var(--cream); }
  .update-card b { display: block; margin-top: 1rem; color: var(--sea); font-size: .82rem; }
  @media (max-width: 850px) {
    .hero, .help-section, .living-section { grid-template-columns: 1fr; }
    .hero { min-height: 0; } .town-note { min-height: 430px; }
    .explore-grid { grid-template-columns: 1fr; }
    .feature-card { min-height: 260px; }
  }
</style>
