---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPlaceGeography, officialBarangays } from '../../data/place-geography';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = (value: string) => `${base}${value}`;

const businesses = await getCollection('businesses', ({ data }) =>
  data.status === 'published' && data.rating !== null && data.rating >= 4 && data.ratingCount >= 20);
const categories = ['all', 'eat', 'stay', 'dive', 'shop', 'transport', 'health', 'services', 'recreation'];
const contentDate = (data: (typeof businesses)[number]['data']) =>
  new Date(data.aboutGeneratedAt ?? data.contactCheckedAt ?? 0).valueOf();
const sortedBusinesses = businesses.map((entry) => ({ entry, geography: getPlaceGeography(entry.data) })).sort((a, b) =>
  (contentDate(a.entry.data) - contentDate(b.entry.data)) || a.entry.data.name.localeCompare(b.entry.data.name));
const localities = [...new Set(sortedBusinesses.map(({ geography }) => geography.locality).filter(Boolean))].sort((a, b) => a.localeCompare(b));
---

<BaseLayout title="Local directory — Go Moalboal" description="Find local businesses and services in Moalboal.">
  <section class="directory-hero section" data-directory-version="approved-rated-20-oldest-first">
    <p class="eyebrow">Local directory</p>
    <h1>Find what you need,<br /><em>close to home.</em></h1>
    <p>Browse {businesses.length} community-reviewed places with at least 20 Google reviews and a 4.0+ rating, ordered oldest first.</p>
  </section>
  <aside class="geography-note" aria-label="Understanding Moalboal place names">
    <span><strong>Municipality</strong> Moalboal</span><i>→</i><span><strong>Barangay</strong> official local government area</span><i>→</i><span><strong>Locality or sitio</strong> familiar neighbourhood name</span><i>→</i><span><strong>Place</strong> business or destination</span>
  </aside>
  <section class="section listing-section">
    <div class="filters" aria-label="Directory categories">
      {categories.map((category) => <a href={path(category === 'all' ? '/directory' : `/directory?category=${category}`)}>{category}</a>)}
    </div>
    <div class="directory-tools">
      <div class="search-control"><label for="directory-search">Search the directory</label><input id="directory-search" type="search" placeholder="Search name, locality or barangay" autocomplete="off" /></div>
      <div><label for="barangay-filter">Official barangay</label><select id="barangay-filter"><option value="">All barangays</option>{officialBarangays.map((barangay) => <option value={barangay}>{barangay}</option>)}</select></div>
      <div><label for="locality-filter">Locality or sitio</label><select id="locality-filter"><option value="">All localities</option>{localities.map((locality) => <option value={locality}>{locality}</option>)}</select></div>
      <p><span id="visible-count">{businesses.length}</span> places shown</p>
    </div>
    <div class="grid">
      {sortedBusinesses.map(({ entry: { data }, geography }) => (
        <a class="card business-card" href={path(`/directory/${data.slug}`)} data-categories={data.categories.join(' ')} data-barangay={geography.barangay} data-locality={geography.locality} data-search={`${data.name} ${data.address} ${data.categories.join(' ')} ${geography.barangay} ${geography.locality}`.toLowerCase()}>
          {data.photos[0] && <div class="card-thumb"><img src={path(data.photos[0].path)} alt="" loading="lazy" /></div>}
          <div class="card-top"><span class="pill">{data.categories.join(' · ')}</span><span>{geography.locality || `Barangay ${geography.barangay}`}</span></div>
          <h3>{data.name}</h3><p>{data.summary}</p>
          {geography.locality && <p class="geography-line"><strong>{geography.locality}</strong> · locality in Barangay {geography.barangay}</p>}
          {data.rating && <span class="rating" aria-label={`${data.rating} out of 5 from ${data.ratingCount} Google reviews`}>★ {data.rating.toFixed(1)} <small>({data.ratingCount.toLocaleString()})</small></span>}
          <span class="arrow">View listing →</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const selected = params.get('category');
  const search = document.querySelector<HTMLInputElement>('#directory-search');
  const barangay = document.querySelector<HTMLSelectElement>('#barangay-filter');
  const locality = document.querySelector<HTMLSelectElement>('#locality-filter');
  const count = document.querySelector<HTMLElement>('#visible-count');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-categories]')];
  if (barangay) barangay.value = params.get('barangay') ?? '';
  if (locality) locality.value = params.get('locality') ?? '';
  const update = () => {
    const query = search?.value.trim().toLowerCase() ?? '';
    const selectedBarangay = barangay?.value ?? '';
    const selectedLocality = locality?.value ?? '';
    let visible = 0;
    cards.forEach((card) => {
      const categoryMatch = !selected || card.dataset.categories?.split(' ').includes(selected);
      const searchMatch = !query || card.dataset.search?.includes(query);
      const barangayMatch = !selectedBarangay || card.dataset.barangay === selectedBarangay;
      const localityMatch = !selectedLocality || card.dataset.locality === selectedLocality;
      card.hidden = !(categoryMatch && searchMatch && barangayMatch && localityMatch);
      if (!card.hidden) visible += 1;
    });
    if (count) count.textContent = String(visible);
    const next = new URLSearchParams(window.location.search);
    selectedBarangay ? next.set('barangay', selectedBarangay) : next.delete('barangay');
    selectedLocality ? next.set('locality', selectedLocality) : next.delete('locality');
    history.replaceState(null, '', `${window.location.pathname}${next.size ? `?${next}` : ''}`);
  };
  search?.addEventListener('input', update);
  barangay?.addEventListener('change', update);
  locality?.addEventListener('change', update);
  update();
</script>

<style>
  .directory-hero { background: var(--cream); }
  .directory-hero h1 { max-width: 12ch; font-size: clamp(3rem, 7vw, 6.5rem); }
  .directory-hero h1 em { color: var(--coral); font-weight: inherit; }
  .directory-hero > p:last-child { font-size: 1.15rem; max-width: 38rem; }
  .geography-note { display: flex; align-items: center; justify-content: center; gap: 1rem; padding: 1rem 5vw; background: var(--sea); color: #fff; font-size: .78rem; }
  .geography-note span { display: flex; flex-direction: column; }
  .geography-note strong { color: var(--sun); text-transform: uppercase; letter-spacing: .08em; font-size: .66rem; }
  .geography-note i { color: var(--sun); }
  .listing-section { background: var(--paper); }
  .filters { display: flex; gap: .55rem; flex-wrap: wrap; margin-bottom: 2rem; }
  .filters a { padding: .55rem .9rem; border: 1px solid var(--line); border-radius: 999px; text-decoration: none; text-transform: capitalize; font-size: .85rem; font-weight: 700; }
  .filters a:hover { background: var(--ink); color: #fff; }
  .directory-tools { display: grid; grid-template-columns: 1.4fr .8fr .8fr auto; gap: 1rem; align-items: end; margin-bottom: 2rem; }
  .directory-tools > div { display: flex; flex-direction: column; gap: .45rem; }
  .directory-tools label { font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
  .directory-tools input, .directory-tools select { width: 100%; min-height: 50px; padding: .8rem .9rem; border: 1px solid var(--line); border-radius: 12px; background: #fff; font: inherit; }
  .directory-tools p { margin: 0 0 .8rem; color: #47635d; font-size: .9rem; white-space: nowrap; }
  .card-thumb { margin: -1.5rem -1.5rem 1rem; border-radius: 20px 20px 0 0; overflow: hidden; }
  .card-thumb img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
  .card-top { display: flex; justify-content: space-between; align-items: start; font-size: .8rem; }
  .arrow { display: block; margin-top: 2rem; font-weight: 700; color: var(--sea); }
  .rating { display: block; margin-top: 1.2rem; color: #8a5c00; font-weight: 800; }
  .rating small { color: #657b76; font-weight: 600; }
  .business-card .geography-line { margin-top: 1rem; padding-top: .85rem; border-top: 1px solid var(--line); color: #47635d; font-size: .78rem; }
  .business-card .geography-line strong { color: var(--sea); }
  [hidden] { display: none; }
  @media (max-width: 900px) { .directory-tools { grid-template-columns: 1fr 1fr; } .search-control { grid-column: 1 / -1; } .geography-note { justify-content: flex-start; overflow-x: auto; } .geography-note span { min-width: 150px; } }
  @media (max-width: 600px) { .directory-tools { grid-template-columns: 1fr; } .search-control { grid-column: auto; } }
</style>
