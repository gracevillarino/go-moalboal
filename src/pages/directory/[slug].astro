---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewCarousels from '../../components/ReviewCarousels.astro';
import { getPlaceGeography } from '../../data/place-geography';

export async function getStaticPaths() {
  const businesses = await getCollection('businesses', ({ data }) => data.status === 'published');
  return businesses.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const geography = getPlaceGeography(data);
const mapUrl = `${base}/map?barangay=${encodeURIComponent(geography.barangay)}`;
const instagramUrl = data.sources
  .map((source) => source.url)
  .find((url) => /instagram\.com\//i.test(url) && !/instagram\.com\/(?:p|reel|tv)\//i.test(url));
---

<BaseLayout title={`${data.name} — Go Moalboal`} description={data.summary}>
  <article>
    <header class="listing-hero section">
      <a href={`${base}/directory`}>← Back to directory</a>
      <div class="listing-title"><div><span class="pill">{data.categories.join(' · ')}</span><h1>{data.name}</h1></div><p>{data.summary}</p></div>
    </header>
    <div class="listing-body section">
      <div>
        {data.sample && <p class="sample-notice"><strong>Fictional sample:</strong> this listing exists only to demonstrate the site and is not a real business.</p>}
        <nav class="place-hierarchy" aria-label="Place geography">
          {geography.hierarchy.map((level: string, index: number) => <><span class={index === geography.hierarchy.length - 1 ? 'current' : ''}>{level}</span>{index < geography.hierarchy.length - 1 && <i>→</i>}</>)}
        </nav>
        <p class="geography-explainer">A <strong>barangay</strong> is an official local government area. {geography.locality ? <><strong>{geography.locality}</strong> is the locality or neighbourhood name people are more likely to use day to day.</> : <>This place is identified directly by its official barangay.</>}</p>
        <h2>About</h2>
        {data.description.split(/\n\n+/).map((paragraph: string) => <p>{paragraph}</p>)}
        <div class="tags">{data.tags.map((tag: string) => <span>#{tag}</span>)}</div>
        {data.sources.length > 0 && <section class="listing-sources" aria-labelledby="listing-sources-title">
          <h3 id="listing-sources-title">Sources</h3>
          <ol>
            {data.sources.map((source) => <li><a href={source.url} rel="noreferrer" target="_blank">{source.title}</a> <span>— {source.publisher}</span></li>)}
          </ol>
        </section>}
      </div>
      <aside>
        <p class="eyebrow">At a glance</p>
        <dl>
          {geography.locality && <><dt>Locality or sitio</dt><dd>{geography.locality}</dd></>}
          <dt>Official barangay</dt><dd><a href={mapUrl}>Barangay {geography.barangay}</a></dd>
          <dt>Address</dt><dd>{data.address}</dd>
          {data.phone && <><dt>Phone</dt><dd><a href={`tel:${data.phone.replace(/[^+\d]/g, '')}`}>{data.phone}</a></dd></>}
          {data.email && <><dt>Email</dt><dd><a href={`mailto:${data.email}`}>{data.email}</a></dd></>}
          {data.website && <><dt>Website</dt><dd><a href={data.website} rel="noreferrer" target="_blank">Visit official website ↗</a></dd></>}
          {data.facebook && <><dt>Facebook</dt><dd><a href={data.facebook} rel="noreferrer" target="_blank">Open Facebook page ↗</a></dd></>}
          {instagramUrl && <><dt>Instagram</dt><dd><a href={instagramUrl} rel="noreferrer" target="_blank">Open Instagram profile ↗</a></dd></>}
          <dt data-live-hours-label hidden>Hours</dt><dd data-live-hours hidden></dd>
          {data.rating && <><dt>Google rating</dt><dd>★ {data.rating.toFixed(1)} from {data.ratingCount.toLocaleString()} reviews</dd></>}
          <dt>Listing status</dt><dd>{data.verified ? 'Owner verified' : 'Community reviewed'}</dd>
        </dl>
        <a class="barangay-link" href={mapUrl}>Explore Barangay {geography.barangay} →</a>
        {data.googleMapsUri && <a class="maps-link" href={data.googleMapsUri} rel="noreferrer" target="_blank">View on Google Maps →</a>}
        <p class="attribution">Rating and place information sourced from Google Maps. Check Google Maps for current details.</p>
      </aside>
    </div>
    <div class="listing-extras section">
      <ReviewCarousels
        googlePlaceId={data.googlePlaceId}
        googleMapsUri={data.googleMapsUri}
        tripadvisorLocationId={data.reviewInsights?.tripadvisor?.locationId}
        tripadvisorUrl={data.reviewInsights?.tripadvisor?.url}
      />
    </div>
  </article>
</BaseLayout>

<style>
  .listing-hero { background: var(--sea); color: #fff; }
  .listing-hero > a { display: inline-block; margin-bottom: 4rem; }
  .listing-title { display: grid; grid-template-columns: 1.4fr .8fr; align-items: end; gap: 4rem; }
  .listing-title h1 { font-size: clamp(3.2rem, 7vw, 6.8rem); }
  .listing-title p { font-size: 1.2rem; }
  .listing-body { display: grid; grid-template-columns: 1.5fr .7fr; gap: 6rem; }
  .listing-body h2 { font-size: 3rem; }
  .sample-notice { padding: 1rem; background: #fff2cc; border-radius: 12px; }
  .place-hierarchy { display: flex; align-items: center; gap: .55rem; flex-wrap: wrap; margin-bottom: 1rem; color: #47635d; font-size: .78rem; }
  .place-hierarchy span { padding: .4rem .65rem; border-radius: 999px; background: var(--cream); }
  .place-hierarchy .current { background: var(--sea); color: #fff; }
  .place-hierarchy i { color: var(--coral); }
  .geography-explainer { max-width: 46rem; margin: 0 0 3rem; padding-left: 1rem; border-left: 3px solid var(--sun); color: #526b65; }
  aside { background: var(--cream); padding: 2rem; border-radius: 20px; }
  dl { margin: 0; } dt { font-size: .75rem; text-transform: uppercase; letter-spacing: .1em; font-weight: 800; margin-top: 1.2rem; } dd { margin: .3rem 0 0; }
  dd a { color: var(--sea); overflow-wrap: anywhere; }
  dd details summary { cursor: pointer; color: var(--sea); font-weight: 700; }
  dd details ul { padding-left: 1rem; font-size: .8rem; }
  .tags { display: flex; gap: .5rem; flex-wrap: wrap; margin-top: 2rem; color: var(--sea); }
  .listing-sources { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .listing-sources h3 { font-size: 1.35rem; }
  .listing-sources ol { padding-left: 1.25rem; }
  .listing-sources li { margin: .6rem 0; }
  .listing-sources span { color: #657b76; font-size: .9rem; }
  .listing-extras { padding-top: 0; }
  .barangay-link, .maps-link { display: block; margin-top: 1.5rem; font-weight: 800; color: var(--sea); }
  .barangay-link { padding: .8rem 1rem; border: 1px solid var(--sea); border-radius: 12px; text-decoration: none; }
  .attribution { margin-top: 1.5rem; color: #657b76; font-size: .75rem; }
  @media (max-width: 750px) { .listing-title, .listing-body { grid-template-columns: 1fr; gap: 2rem; } }
</style>
