---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const opportunities = await getCollection('volunteer', ({ data }) => data.status === 'published');
const organizations = await getCollection('organizations', ({ data }) => data.status === 'published');
const availabilityLabel = {
  active: 'Currently listed',
  'recurring-contact-first': 'Recurring · contact first',
  'seasonal-contact-first': 'Seasonal · contact first',
};
---
<BaseLayout title="Volunteer and community organisations in Moalboal — Go Moalboal" description="Current and recurring ways to volunteer in Moalboal, plus local organisations working in animal welfare, conservation and civic service.">
  <section class="community-hero section" id="help"><p class="eyebrow">Community</p><h1>Good work needs<br />more hands.</h1><p>Start with organisations already doing the work. Every listing below links to the source we checked; always confirm directly before committing time, money or travel.</p></section>

  <section class="opportunity-section section" id="volunteer">
    <div class="section-heading"><div><p class="eyebrow">How can I help?</p><h2>Current and recurring<br />opportunities.</h2></div><p>Availability checked 15 July 2026. “Contact first” means the work is recurring but no future public date was confirmed.</p></div>
    <div class="opportunity-grid">
      {opportunities.map(({ data }) => <article class="opportunity-card">
        <div class="opportunity-top"><span class="pill">{data.category}</span><span class="availability">{availabilityLabel[data.availability]}</span></div>
        <h3>{data.name}</h3><p>{data.summary}</p>
        <dl><div><dt>Commitment</dt><dd>{data.commitment}</dd></div><div><dt>Where</dt><dd>{data.barangay}</dd></div><div><dt>Schedule</dt><dd>{data.schedule}</dd></div></dl>
        <h4>How to help</h4><ul>{data.howToHelp.map((step) => <li>{step}</li>)}</ul>
        <footer><a href={data.contactUrl} target="_blank" rel="noreferrer">Contact or apply ↗</a><a class="source-link" href={data.sourceUrl} target="_blank" rel="noreferrer">View source</a></footer>
      </article>)}
    </div>
  </section>

  <section class="organization-section section" id="organizations">
    <div class="section-heading"><div><p class="eyebrow">People already helping</p><h2>Local organisations<br />and partners.</h2></div><p>These profiles document recent activity in Moalboal. Inclusion is informational, not an endorsement or a claim that every group currently accepts volunteers.</p></div>
    <div class="organization-grid">
      {organizations.map(({ data }) => {
        const contact = data.contact.website || data.contact.instagram || data.contact.facebook || data.sourceUrl;
        return <a class="organization-card" href={contact} target="_blank" rel="noreferrer"><span class="organization-type">{data.category}</span><h3>{data.name}</h3><p>{data.summary}</p><footer><span>{data.barangay}</span><strong>Learn more ↗</strong></footer></a>;
      })}
    </div>
  </section>

  <section class="safety-note section"><p class="eyebrow">Volunteer well</p><h2>Help should be useful,<br />safe and accountable.</h2><div class="safety-grid"><p>Confirm who supervises the work, what the organisation genuinely needs and whether your skills fit. Never enter the water for clean-up work without the required training and local safety direction.</p><p>Workaway is a third-party membership platform. Review its host information, feedback, insurance implications and exchange terms yourself before applying. Donations should go only through channels confirmed by the organisation.</p></div></section>
</BaseLayout>
<style>
  .community-hero { min-height: 620px; display: flex; flex-direction: column; justify-content: center; background: linear-gradient(125deg,var(--cream),rgba(8,127,120,.18)); }.community-hero > p:last-child { max-width: 48rem; margin-top: 2rem; color: #47635d; font-size: 1.2rem; }
  .opportunity-section { background: var(--paper); }.opportunity-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; }.opportunity-card { display: flex; flex-direction: column; padding: 1.5rem; border: 1px solid var(--line); border-radius: 22px; }.opportunity-top { display: flex; align-items: start; justify-content: space-between; gap: .7rem; }.availability { color: var(--sea); font-size: .72rem; font-weight: 800; }.opportunity-card > p,.opportunity-card dd,.opportunity-card li { color: #4d6760; }.opportunity-card dl { margin: 1.2rem 0; }.opportunity-card dl div { padding: .7rem 0; border-top: 1px solid var(--line); }.opportunity-card dt { font-size: .68rem; font-weight: 800; text-transform: uppercase; letter-spacing: .09em; }.opportunity-card dd { margin: .2rem 0 0; }.opportunity-card h4 { margin-bottom: .2rem; }.opportunity-card ul { padding-left: 1.2rem; }.opportunity-card footer { display: flex; justify-content: space-between; gap: .7rem; margin-top: auto; padding-top: 1rem; }.opportunity-card footer a { font-weight: 800; }.source-link { color: #61766f; font-size: .78rem; }
  .organization-section { background: var(--cream); }.organization-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; }.organization-card { min-height: 260px; display: flex; flex-direction: column; padding: 1.5rem; border-radius: 20px; background: var(--paper); text-decoration: none; }.organization-card:hover { transform: translateY(-3px); }.organization-type { color: var(--coral); font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .09em; }.organization-card h3 { margin-top: 1.2rem; }.organization-card p { color: #506a63; }.organization-card footer { display: flex; justify-content: space-between; gap: 1rem; margin-top: auto; font-size: .8rem; }
  .safety-note { background: var(--ink); color: #fff; }.safety-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; max-width: 900px; margin-top: 2rem; color: #bdd0ca; }
  @media(max-width:950px){.opportunity-grid,.organization-grid{grid-template-columns:1fr 1fr}}@media(max-width:650px){.opportunity-grid,.organization-grid,.safety-grid{grid-template-columns:1fr}}
</style>
